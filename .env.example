# One Crunch Lady - environment template.
#
# Copy to .env.local and fill in. Values are grouped by who supplies
# them: everything under CLIENT is business/brand info the bakery owner
# provides once; everything under INFRASTRUCTURE is set up by whoever
# stands up Supabase/Cloudinary/Resend/Vercel for them.
#
# Public config (read in config/site.ts) uses the NEXT_PUBLIC_ prefix and
# is bundled into the browser - never put a secret behind that prefix.
# Everything else (config/server.ts) is server-only and validated at
# boot; the app will not start without every server-only value below.

# ============================================================
# CLIENT - business details the owner provides
# ============================================================

# Recipient for new-order alert emails (server-only).
OWNER_EMAIL=owner@example.com

# Singapore mobile number PayNow QR codes are generated for (server-only,
# never sent to the browser). Accepts a bare 8-digit number starting with
# 8 or 9, with or without a +65/65 prefix - see lib/paynow.ts.
PAYNOW_NUMBER=8XXXXXXX

# WhatsApp contact number in wa.me format (country code, no + or spaces),
# e.g. 65XXXXXXXX for Singapore. Public - used to build wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=65XXXXXXXX

# Social links. Footer icons always render; leave blank to fall back to
# the platform's generic homepage.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Public site origin - used for the admin dashboard link in owner emails,
# for Open Graph/canonical URLs, and for robots.ts/sitemap.ts. Falls back
# to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified sender address for all outgoing email (server-only). Must be
# on a domain verified in Resend - the resend.dev sandbox address only
# delivers to the Resend account owner, so customer-facing email will
# silently fail to deliver in production until this points at a real
# verified domain.
EMAIL_FROM=One Crunch Lady <orders@yourdomain.com>

# ============================================================
# INFRASTRUCTURE - set up alongside Supabase/Cloudinary/Resend
# ============================================================

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- CLOUDINARY ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Unsigned upload preset used by the admin product-image widget
# (components/features/AdminOrdersClient.tsx).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# --- RESEND ---
RESEND_API_KEY=your_resend_key
